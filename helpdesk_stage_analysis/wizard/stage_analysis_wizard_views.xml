<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="stage_analysis_wizard_view_form" model="ir.ui.view">
        <field name="name">helpdesk.stage.analysis.wizard.form</field>
        <field name="model">helpdesk.stage.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Stage Analysis Report">
                <group>
                    <group>
                        <field name="date_from" widget="daterange" options="{'end_date_field': 'date_to'}"/>
                        <field name="date_to" invisible="1"/>
                    </group>
                    <group>
                        <field name="team_ids" widget="many2many_tags" options="{'no_create': True, 'no_edit': True}"/>
                        <field name="stage_ids" widget="many2many_tags" options="{'no_create': True, 'no_edit': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report" string="Generate Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_stage_analysis_wizard" model="ir.actions.act_window">
        <field name="name">Stage Analysis</field>
        <field name="res_model">helpdesk.stage.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item: Helpdesk > Reporting > Stage Analysis -->
    <menuitem
        id="menu_helpdesk_stage_analysis"
        name="Stage Analysis"
        parent="helpdesk.helpdesk_ticket_report_menu_main"
        action="action_stage_analysis_wizard"
        sequence="40"/>
</odoo>
